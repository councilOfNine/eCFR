{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/.wrangler",
      "!coverage",
      "!sync-output",
      "!.sync-cache",
      "!fixtures/content",
      "!fixtures/raw",
      "!fixtures/seed.sql",
      "!apps/api/public/dist",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    // global.css uses Tailwind 4 directives (@theme, @custom-variant); without this the
    // file is a hard parse error.
    "parser": { "tailwindDirectives": true }
  },
  "json": {
    "parser": { "allowComments": true, "allowTrailingCommas": true },
    // trailingCommas MUST stay "none": wrangler.jsonc files are read by tooling that strips
    // comments and then calls plain JSON.parse (apps/api/test/config.test.ts asserts the
    // rate-limit bindings match TIERS), and JSON.parse rejects trailing commas.
    "formatter": { "trailingCommas": "none" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  // Rule 3 of the repo's non-negotiables (no RegExp from a non-literal — the predecessor's
  // ReDoS) lives in this GritQL plugin; eslint's no-restricted-syntax used to enforce it.
  "plugins": ["./biome-plugins/no-dynamic-regexp.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // `any` needs a written justification; a suppression comment with a reason IS that
        // justification, placed next to the escape hatch and visible in the diff.
        "noExplicitAny": "error",
        // @ts-ignore silences the checker anonymously; @ts-expect-error fails once the
        // underlying problem is fixed. Biome cannot enforce a minimum description length the
        // way typescript-eslint did — reviewers hold that line now.
        "noTsIgnore": "error",
        "noDoubleEquals": { "level": "error", "options": { "ignoreNull": true } },
        "noConsole": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        // A dropped promise in the sync pipeline is a silently skipped write, and every write
        // is an insert-then-prune step whose ordering is load-bearing. These use Biome's own
        // type inference — weaker than tsc-backed typescript-eslint, but they run on every
        // save; tsc strict in CI remains the authority. Nursery rules can move groups between
        // Biome minors; if an upgrade drops one of these keys, relocate it — do not delete it.
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "overrides": [
    {
      // Astro components: Biome parses only the frontmatter fence. Formatting stays off
      // (same coverage prettier had — none), linting on for the TS inside the fence.
      // The unused-* rules are off because a frontmatter variable's usage lives in the
      // template BELOW the fence, which Biome cannot see — every hit is a false positive.
      // `astro check` in the web build sees the whole component and covers this properly.
      "includes": ["**/*.astro"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      // Generated or vendored code is not held to authored-code standards.
      "includes": ["apps/web/src/data/gen/**", "**/worker-configuration.d.ts"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
