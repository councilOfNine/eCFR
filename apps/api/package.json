{
  "name": "@ecfr-atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "pnpm run vendor:scalar && wrangler dev",
    "deploy": "pnpm run vendor:scalar && wrangler deploy",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "//vendor:scalar": "Copies the pinned @scalar/api-reference bundle from node_modules into public/dist/, so /docs loads it from this origin instead of a CDN. Chained into dev and deploy; the output is git-ignored. Plain `node`: type stripping runs .ts directly on Node >=22.18 (the .nvmrc line).",
    "vendor:scalar": "node scripts/vendor-scalar.ts"
  },
  "dependencies": {
    "@ecfr-atlas/core": "workspace:*",
    "@hono/zod-openapi": "^1.5.1",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@scalar/api-reference": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
