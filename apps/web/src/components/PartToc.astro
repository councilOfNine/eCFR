---
/**
 * The reader's table of contents.
 *
 * Rows arrive with their destination already decided by the page (see PartTocRow): a plain
 * anchor for a section on this page, a cross-page link into the owning slice on a split-part
 * index, or no link at all for a reserved range — there is nothing to jump to, and a link
 * that lands nowhere is worse than a label.
 *
 * Plain anchors in a <nav>, so it is keyboard-navigable by default — tab moves through it,
 * enter follows, and the browser's own find-in-page works on it. The active-section
 * highlight is added by an IntersectionObserver, which is the only JS here and is purely
 * decorative: with it disabled the TOC still navigates correctly. Only same-page rows carry
 * `data-toc-target`, so the observer never tracks a link that leaves the page.
 *
 * `scroll-margin-top` on the headings (see global.css) keeps a jumped-to section clear of the
 * viewport edge without any scroll maths. The list's pl-1/-ml-1 pair gives focus rings room
 * inside the overflow clip without shifting its left edge out of alignment.
 */
import { STRINGS } from '../constants/strings';
import type { PartTocRow } from './types';
import WordCountView from './WordCount.astro';

interface Props {
  rows: PartTocRow[];
}

const { rows } = Astro.props;
---

<nav aria-labelledby="toc-heading" class="text-sm" data-part-toc>
  <h2 id="toc-heading" class="eyebrow mb-2">
    {STRINGS.partToc.heading}<span class="ml-1 font-normal normal-case tracking-normal">{STRINGS.partToc.count(rows.length)}</span>
  </h2>
  {
    rows.length === 0 ? (
      <p class="text-xs text-[color:var(--color-ink-subtle)]">
        {STRINGS.partToc.empty}
      </p>
    ) : (
      <ol class="-ml-1 max-h-[70vh] overflow-y-auto pl-1 pr-1">
        {rows.map((row) => (
          <li>
            {row.href === null ? (
              <span class="toc-link toc-link-static">
                <span class="flex items-baseline justify-between gap-2">
                  <span class="truncate">
                    <span class="font-mono text-[0.72rem] text-[color:var(--color-ink-subtle)]">
                      §&nbsp;{row.section.identifier}
                    </span>
                    <span class="ml-1">
                      {row.section.reserved ? STRINGS.common.reservedHeading : row.section.label}
                    </span>
                  </span>
                  <WordCountView value={row.section.word_count} variant="compact" class="text-[0.68rem]" />
                </span>
              </span>
            ) : (
              <a
                href={row.href}
                class="toc-link"
                data-toc-target={row.samePage ? row.section.anchor : undefined}
              >
                <span class="flex items-baseline justify-between gap-2">
                  <span class="truncate">
                    <span class="font-mono text-[0.72rem] text-[color:var(--color-ink-subtle)]">
                      §&nbsp;{row.section.identifier}
                    </span>
                    <span class="ml-1">
                      {row.section.reserved ? STRINGS.common.reservedHeading : row.section.label}
                    </span>
                  </span>
                  <WordCountView value={row.section.word_count} variant="compact" class="text-[0.68rem]" />
                </span>
              </a>
            )}
          </li>
        ))}
      </ol>
    )
  }
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-part-toc]');
  const targets = [...document.querySelectorAll<HTMLElement>('.reg-prose [id]')];

  if (nav && targets.length > 0 && 'IntersectionObserver' in window) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of nav.querySelectorAll<HTMLAnchorElement>('[data-toc-target]')) {
      const key = link.dataset.tocTarget;
      if (key) links.set(key, link);
    }

    let current: HTMLAnchorElement | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        // Topmost intersecting section wins, so scrolling up highlights what you are reading
        // rather than what you just left.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        const next = links.get(visible.target.id);
        if (!next || next === current) return;
        current?.removeAttribute('aria-current');
        next.setAttribute('aria-current', 'true');
        // Keep the highlight in view in a long TOC without yanking the page.
        next.scrollIntoView({ block: 'nearest' });
        current = next;
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    );

    for (const target of targets) observer.observe(target);
  }
</script>
