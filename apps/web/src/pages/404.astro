---
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../constants/site';
import { STRINGS } from '../constants/strings';
import * as route from '../data/routes';
/**
 * Served by Workers Static Assets for any unmatched path (`not_found_handling: "404-page"`).
 *
 * Most 404s here will be a hand-typed or stale CFR citation, so the page's job is to get the
 * reader back to a real citation rather than to apologise. It links to the browsable entry
 * points and to the official eCFR, which is authoritative for anything this site has not
 * measured yet.
 *
 * The two lists below stay inline: every item is a link or a `<code>` sample followed by its
 * own gloss, so hoisting them would leave sentence fragments that no translator can reorder.
 */
import Base from '../layouts/Base.astro';
---

<Base
  title={STRINGS.notFound.title}
  description={STRINGS.notFound.description}
>
  <PageHeader
    eyebrow={STRINGS.notFound.eyebrow}
    title={STRINGS.notFound.heading}
    standfirst={STRINGS.notFound.standfirst}
  />

  <div class="prose-page">
    <h2>{STRINGS.notFound.whereHeading}</h2>
    <ul>
      <li><a href={route.home()}>Dashboard</a> — corpus totals and the agency ranking.</li>
      <li><a href={route.titleIndex()}>Browse by CFR title</a> — then chapter, then part.</li>
      <li><a href={route.agencyIndex()}>Browse by agency</a> — filterable by name.</li>
      <li>
        <a href={route.sharedJurisdiction()}>Shared jurisdiction</a> — scopes with more than one
        claimant.
      </li>
    </ul>

    <h2>{STRINGS.notFound.urlShapesHeading}</h2>
    <ul>
      <li><code>/title/40</code> — a CFR title</li>
      <li><code>/title/40/chapter/I</code> — a chapter, by Roman numeral</li>
      <li><code>/title/40/part/60</code> — a part, with its full text</li>
      <li><code>/title/26/part/1/A</code> — one subpart of a part too large to serve whole</li>
      <li><code>/agency/environmental-protection-agency</code> — an agency</li>
    </ul>

    <p>
      Not every scope has a page of its own: subtitles and subchapters are real levels of the CFR
      but carry no standalone content, so links to them resolve to the nearest title or chapter.
      For anything this site does not cover, the official text is at
      <a href={SITE.ecfrHomeUrl} rel="external noopener"> ecfr.gov</a>.
    </p>
  </div>
</Base>
