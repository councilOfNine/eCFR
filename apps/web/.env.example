# apps/web build-time configuration.
#
# Every variable is read in Node during `astro build` — nothing here is a runtime secret, and
# nothing is read in a Worker on the request path. `PUBLIC_`-prefixed variables are the
# deployment-identity overrides consumed by src/constants/site.ts; the ECFR_* variables select
# which data source the build reads (src/data/load.ts).

# ── deployment identity (src/constants/site.ts) ─────────────────────────────

# Site name, shown in the header brand, tab titles and citation copy.
# Default: eCFR Atlas
#PUBLIC_SITE_NAME=

# One-line tagline beside the brand in the header.
# Default: a measured map of federal regulation
#PUBLIC_SITE_TAGLINE=

# Canonical origin for <link rel="canonical">, og metadata and the sitemap. No trailing slash.
# Also consumed by astro.config.ts as the `site` setting.
# Default: https://ecfr-atlas.org
#PUBLIC_SITE_URL=

# Public origin of the API Worker (apps/api). Linked from /api; never fetched by any page.
# Default: https://api.ecfr-atlas.org
#PUBLIC_API_ORIGIN=

# Source repository, for attribution and contributing links.
# Default: https://github.com/itsmiketorres/USDS
#PUBLIC_REPO_URL=

# Contact address for the operator of this deployment. Unset renders no contact affordance.
# Default: (unset)
#PUBLIC_CONTACT_EMAIL=

# ── data source selection (src/data/load.ts) ────────────────────────────────

# Directory holding the JSON snapshot emitted by scripts/sync. Preferred source: the only one
# that carries regulation body text.
#ECFR_SNAPSHOT_DIR=

# Path to a local D1 sqlite file (.wrangler/state/v3/d1/**/*.sqlite). Contributor fallback;
# body text renders as unavailable, and the reader pages say so.
#ECFR_D1_SQLITE=

# Set to 1 to force the committed fixture even when a real source is configured. Every page then
# carries the fixture banner. Useful for reproducing a UI bug without a database.
#ECFR_USE_FIXTURE=
