{
  "name": "@ecfr-atlas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/gen-api-endpoints.ts && astro dev",
    "build": "node ./scripts/gen-api-endpoints.ts && astro build && node ./scripts/build-headers.ts && ASSET_BUDGET_REPORT=dist/asset-budget.json node ../../scripts/ci/check-asset-count.ts dist/client && node ./scripts/check-html.ts && node ./scripts/check-headers.ts",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "astro check",
    "check": "ASSET_BUDGET_REPORT=dist/asset-budget.json node ../../scripts/ci/check-asset-count.ts dist/client && node ./scripts/check-html.ts && node ./scripts/check-headers.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "@ecfr-atlas/core": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "7.1.3",
    "tailwindcss": "^4.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
